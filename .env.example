# Copy to .env (never commit .env). docker compose reads these values.

# --- Real Google sign-in (leave commented to use the local mock OIDC server) ---
# BASKETIQ_OIDC_ISSUER=https://accounts.google.com
# BASKETIQ_OIDC_INTERNAL_BASE_URL=
# BASKETIQ_OIDC_BROWSER_BASE_URL=
# BASKETIQ_OIDC_CLIENT_ID=<client id>.apps.googleusercontent.com
# BASKETIQ_OIDC_CLIENT_SECRET=<client secret>

# Passkey domain (RP ID). Defaults to the host of BASKETIQ_FRONTEND_BASE_URL. Changing it invalidates
# every registered passkey: fix it before the first real user (README, "Passkeys").
# BASKETIQ_WEBAUTHN_RP_ID=

# Comma-separated e-mails that get the operator (admin) role.
BASKETIQ_ADMIN_EMAILS=admin@basketiq.local

# The product name for customers and the LLM_ENABLED flag are NOT set here: they live only in
# config/app-config.yaml.

# External OCR/AI fallback: disabled | mock. No real provider is wired yet.
BASKETIQ_EXTERNAL_FALLBACK=disabled
